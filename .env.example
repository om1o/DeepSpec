GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CHAT_FALLBACK_MODELS=gemini-2.5-flash-lite
HUGGINGFACE_API_KEY=
HUGGINGFACE_OCR_MODEL=microsoft/trocr-large-printed

# Server-only. Required for /api/account-entitlement to verify Supabase sessions
# and read billing_entitlements. Never expose this as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only billing config. Leave BILLING_PROVIDER blank until a production
# provider is selected. Set BILLING_PROVIDER=stripe only when using the current
# Stripe adapter and sandbox/live keys below.
BILLING_PROVIDER=
DEEPSPEC_ENFORCE_SCAN_CREDITS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEEPSPEC_PLUS_MONTHLY=
STRIPE_PRICE_DEEPSPEC_PLUS_YEARLY=
STRIPE_PRICE_DEEPSPEC_SCAN_PACK=
STRIPE_PRICE_DEEPSPEC_PRO_BETA=
DEEPSPEC_PUBLIC_URL=http://localhost:5174

# Backup identify provider for /api/identify when Gemini is rate-limited or unavailable.
# The adapter is OpenAI-compatible, so this works with OpenRouter (recommended free option),
# Groq, or any OpenAI-compatible chat-completions endpoint.
# Recommended free path: OpenRouter — no credit card, several free vision models on one key.
#   1. Create a key at https://openrouter.ai/keys (starts with sk-or-).
#   2. Set the vars below. Leave HF_IDENTIFY_PROVIDER unset for OpenRouter.
#   3. Verify the model returns parseable JSON: npm run eval:identify:hf-health
# Note: with the OpenRouter endpoint the stored model run is still labeled provider "huggingface".
DEEPSPEC_ENABLE_HF_IDENTIFY_FALLBACK=false
HF_TOKEN=
HF_IDENTIFY_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions
HF_IDENTIFY_MODEL=google/gemma-4-31b-it:free
# HF_IDENTIFY_PROVIDER=    # only for Hugging Face routed inference; leave unset for OpenRouter
DEEPSPEC_HF_IDENTIFY_TIMEOUT_MS=45000

# Second backup, tried after Gemini when explicitly enabled: Groq free tier
# (Llama 4 Scout vision, OpenAI-compatible). Get a key at
# https://console.groq.com/keys (starts with gsk_).
DEEPSPEC_ENABLE_GROQ_IDENTIFY_FALLBACK=false
GROQ_API_KEY=
GROQ_IDENTIFY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_IDENTIFY_ENDPOINT_URL=https://api.groq.com/openai/v1/chat/completions

# Backup rate-limit retry (applies to the Groq + OpenRouter backups; NOT the fast 429->switch on Gemini).
DEEPSPEC_BACKUP_RATE_LIMIT_RETRIES=1
DEEPSPEC_BACKUP_RETRY_BACKOFF_MS=800

# On-device offline fallback (browser-side). When enabled, scans taken with no connection are
# identified by a small in-browser model (SmolVLM-256M via WebGPU, WASM fallback) that downloads
# once (~150-250MB) and caches for offline use. Rough best-guess only; the cloud chain stays
# primary whenever there is any signal, and offline results are clearly labelled as estimates.
VITE_ENABLE_ON_DEVICE_FALLBACK=false

DEEPSPEC_DATASET_ROOT=datasets/raw/drbimmer-car-parts-and-damage-dataset
DEEPSPEC_DATASET_INDEX_PATH=datasets/derived/drbimmer-car-parts-and-damage-dataset/records.jsonl
DEEPSPEC_EVAL_DELAY_MS=20000
DEEPSPEC_EVAL_MAX_PROVIDER_FAILURES=1

# Emergency local dev fallback for /api/identify only.
# Requires `ollama serve` and `ollama pull llava`.
DEEPSPEC_ENABLE_OLLAMA_IDENTIFY_FALLBACK=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_IDENTIFY_MODEL=llava:latest
DEEPSPEC_OLLAMA_IDENTIFY_TIMEOUT_MS=180000

# Optional cloud sync. Use the Supabase publishable/anon key only.
# Never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: set to true only after the provider is configured in Supabase.
VITE_ENABLE_GOOGLE_AUTH=
VITE_ENABLE_GITHUB_AUTH=

# Optional live auth verification inputs for `npm run verify:auth`.
# Use a real test inbox and never commit real values.
DEEPSPEC_AUTH_TEST_EMAIL=
DEEPSPEC_AUTH_TEST_PASSWORD=
DEEPSPEC_AUTH_SEND_CODE=false
DEEPSPEC_AUTH_TEST_EMAIL_CODE=
DEEPSPEC_AUTH_REQUIRE_CREDENTIALS=false
