{
  "git": {
    "deploymentEnabled": {
      "codex/pilot-assembled-20261103": false,
      "codex/car-inspection-evidence-20261105": false,
      "codex/car-condition-evidence-20261105": false,
      "codex/car-component-map-20261105": false,
      "codex/car-vehicle-context-20261105": false,
      "codex/car-mechanic-handoff-20261105": false,
      "codex/car-inspection-followup-20261105": false,
      "codex/car-dated-comparisons-20261105": false,
      "codex/car-diagnostic-imports-20261105": false,
      "codex/car-vehicle-references-20261105": false,
      "codex/car-claim-evidence-fixes-20261105": false,
      "codex/car-preview-local-save-20261105": false,
      "codex/car-isolation-integrity-20261105": false,
      "codex/car-photo-relationships-20261105": false,
      "codex/car-photo-review-20261105": false,
      "codex/car-map-occurrences-20261105": false,
      "codex/car-map-source-20261105": false,
      "codex/car-linked-source-20261105": false,
      "codex/car-requested-capture-20261105": false,
      "codex/car-requested-history-20261105": false
    }
  },
  "functions": {
    "api/identify.ts": {
      "includeFiles": "datasets/verified/hf-automotive-sources-v1/records.jsonl",
      "maxDuration": 90
    },
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/vehicle-reference.ts": {
      "maxDuration": 30
    },
    "api/account-entitlement.ts": {
      "maxDuration": 30
    },
    "api/billing-checkout.ts": {
      "maxDuration": 30
    },
    "api/billing-portal.ts": {
      "maxDuration": 30
    },
    "api/billing-webhook.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://huggingface.co https://*.aws.cdn.hf.co; font-src 'self' data: https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob: https:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; worker-src 'self' blob:"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
