{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepspec.local/schemas/scan-request.schema.json",
  "title": "ScanImageRequestMeta",
  "type": "object",
  "properties": {
    "hints": {
      "type": "object",
      "properties": {
        "expected_manufacturer": { "type": ["string", "null"] },
        "locale": { "type": "string", "default": "en-US" }
      },
      "additionalProperties": false
    },
    "device_signals": {
      "type": "object",
      "properties": {
        "barcode_text": { "type": ["string", "null"] },
        "ocr_lines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blur_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "1 sharp, 0 very blurry"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
