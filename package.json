{
  "name": "deep-spec",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "check": "npm run lint && npm test && npm run build",
    "dataset:sort": "node scripts/sort-drbimmer-dataset.mjs",
    "dataset:source-manifest": "node scripts/build-source-manifest.mjs",
    "dataset:verified-sources": "node scripts/build-verified-vehicle-reference.mjs",
    "eval:identify": "node scripts/eval-identify.mjs",
    "eval:identify:hf-health": "node scripts/eval-identify.mjs --provider hf --sample-size 1 --delay-ms 0 --rate-limit-retries 0 --max-provider-failures 1 --output artifacts/release-gates/hf-health.jsonl --summary artifacts/release-gates/hf-health-summary.json",
    "eval:identify:provider-health": "node scripts/eval-identify.mjs --sample-size 1 --delay-ms 0 --rate-limit-retries 0 --max-provider-failures 1 --output artifacts/release-gates/provider-health.jsonl --summary artifacts/release-gates/provider-health-summary.json",
    "eval:identify:release": "node scripts/eval-identify.mjs --sample-size 50 --max-provider-failures 1 && node scripts/verify-identify-eval-summary.mjs --min-sample-size 50",
    "eval:identify:public": "node scripts/eval-identify.mjs --sample-set public --sample-size 300 --delay-ms 0 --provider-timeout-ms 90000 --max-provider-failures 1 && node scripts/verify-identify-eval-summary.mjs --min-sample-size 300",
    "lint": "eslint .",
    "qa:doctor": "node scripts/qa/qa-doctor.mjs",
    "qa:external-ar": "node scripts/qa/external-ar-tester.mjs",
    "qa:phone-card": "node scripts/qa/phone-test-card.mjs",
    "qa:phone-audit": "node scripts/qa/phone-device-audit.mjs",
    "qa:real": "node scripts/qa/real-website-tester.mjs",
    "qa:serve-production": "node scripts/qa/serve-production.mjs",
    "qa:web-ar": "node scripts/qa/web-ar-tester.mjs",
    "test": "vitest run --configLoader native --pool threads --maxWorkers=1 --no-file-parallelism",
    "test:website": "node scripts/qa/test-website.mjs",
    "supabase:print-migration": "node scripts/print-supabase-migration.mjs",
    "supabase:print-auth-diagnostics": "node scripts/print-supabase-auth-diagnostics.mjs",
    "verify:identify-eval": "node scripts/verify-identify-eval-summary.mjs",
    "verify:auth": "node scripts/verify-auth-flows.mjs",
    "verify:billing-provider": "node scripts/verify-billing-provider.mjs",
    "verify:billing-webhook-replay": "node scripts/verify-billing-webhook-replay.mjs",
    "verify:paid-launch-readiness": "node scripts/verify-paid-launch-readiness.mjs",
    "verify:supabase": "node scripts/verify-supabase-sync.mjs",
    "preview": "vite preview --host 0.0.0.0 --configLoader native",
    "qa:impact": "node scripts/qa/user-impact-plan.mjs",
    "qa:run": "node scripts/qa/run-user-impact-qa.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^6.30.3",
    "react-webcam": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  }
}
