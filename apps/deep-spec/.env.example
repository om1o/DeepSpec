GEMINI_API_KEY=

# Optional Supabase (anonymous auth + private Storage). When missing, device uses localStorage only.
# VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# Gemini proxy (local + Vercel /api/ai) — max JSON body footprint for /api/ai
# AI_MAX_BODY_BYTES=6291456

# GEMINI_VISION_MODEL=gemini-2.5-pro
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# DEEP_SPEC_API_PORT=8788
